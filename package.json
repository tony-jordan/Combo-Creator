{
  "name": "ComboCreator",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "docker:build": "docker build -t combo-creator .",
    "docker:run": "docker run --rm -v %cd%:/app -v combo_node_modules:/app/node_modules -v %USERPROFILE%/.gradle/gradle.properties:/root/.gradle/gradle.properties:ro -w /app combo-creator bash -c \"CI=true npx jest --runInBand && cd android && ./gradlew bundleRelease --no-daemon --stacktrace\"",
    "full-release": "npm run docker:build && npm run docker:run",
    "release": "npm run docker:run"
  },
  "dependencies": {
    "@react-native-community/checkbox": "^0.5.20",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-native-community/slider": "^5.1.2",
    "@react-native/new-app-screen": "0.81.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.0",
    "@react-navigation/stack": "^7.6.15",
    "@sayem314/react-native-keep-awake": "^1.4.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-sound": "^0.13.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.15.1",
    "react-native-system-navigation-bar": "^2.8.0",
    "react-native-tts": "^4.1.1",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/runtime": "^7.28.6",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.81.0",
    "@react-native/eslint-config": "0.81.0",
    "@react-native/metro-config": "0.81.0",
    "@react-native/typescript-config": "^0.81.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.8",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "3.8.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
